# Copy to .env for local testing. .env is gitignored.
# A sandbox key (es_test_...) enables the live test cases in test/app.test.js
# and spends no credits. Create one at https://www.hostsherlock.com/api.
HOSTSHERLOCK_SANDBOX_KEY=es_test_xxxxxxxxxxxxxxxx

# Optional: point the integration at a non-production host during development.
# API_BASE_URL=https://api.emailsherlock.com
